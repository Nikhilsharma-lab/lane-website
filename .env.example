# Copy this file to `.env.local` for local development.
# These variable NAMES match what's already set in the Vercel project (from the
# previous version), so the deployed waitlist works with no extra configuration.

# --- Supabase (stores waitlist signups in the public.waitlist table) ---
# The anon key is browser-safe: the table's RLS allows INSERT only, no reads.
# Supabase → Project Settings → Data API (URL) and API Keys (anon / public key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Resend (confirmation email + signup notification) ---
# API key: Resend → API Keys. From address must be on a domain you've verified
# in Resend (uselane.app). NOTIFY_EMAIL gets a ping on every signup.
RESEND_API_KEY=re_your_key
NOTIFY_EMAIL=you@example.com

# Optional — override the From address (default: "Lane <waitlist@uselane.app>").
# RESEND_FROM=Lane <waitlist@uselane.app>
